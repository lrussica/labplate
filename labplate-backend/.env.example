# Kopiere diese Datei lokal zu ".env" und trage NUR fuer lokale Tests auf
# deinem eigenen Rechner Werte ein - siehe README.md. Diese Beispieldatei
# selbst enthaelt und darf niemals echte Schluesselwerte enthalten.
#
# Beim Hosting-Anbieter (z.B. Render) traegst du die echten Werte NICHT hier
# ein, sondern direkt im Dashboard des Anbieters als Umgebungsvariablen -
# siehe README.md, Abschnitt "Umgebungsvariable GEMINI_API_KEY setzen".

# Pflicht: dein Google-Gemini-API-Schluessel aus dem Google AI Studio
# (Format "AIzaSy..."). NIEMALS hier im Repository eintragen, NIEMALS
# committen - nur als geheime Umgebungsvariable beim Hosting-Anbieter.
GEMINI_API_KEY=

# Optional: welches Gemini-Modell verwendet wird. Leer lassen fuer den
# eingebauten Standardwert (gemini-3.7-flash).
GEMINI_MODEL=

# Optional: Port, auf dem der Server lauscht. Die meisten Hosting-Anbieter
# setzen PORT automatisch selbst - dann NICHT ueberschreiben.
PORT=3000

# Pflicht (fuer den echten Betrieb): kommagetrennte Liste erlaubter Origins,
# die den Endpunkt per Browser-fetch()/XHR ansprechen duerfen. "null" deckt
# den in WKWebViews ueblichen Fall ab, dass eine lokal aus dem App-Bundle
# geladene HTML-Datei (file://) als Origin "null" sendet. Beispiel mit
# zusaetzlicher eigener Web-Domain:
# ALLOWED_ORIGINS=null,https://meine-domain.tld
ALLOWED_ORIGINS=null

# Optional: Rate-Limit (Schutz vor unbegrenzten/kostenpflichtigen Anfragen).
# Standard: 20 Anfragen pro 15 Minuten und IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Optional: Timeout (in Millisekunden) fuer die Anfrage an die Gemini-API.
REQUEST_TIMEOUT_MS=18000
